# Copy to .env (git-ignored) and adjust. The API reads these; defaults suit `docker compose up`.
# To use Neon instead, run `neon env pull`: it writes DATABASE_URL to .env.local, which overrides .env.
# Plain postgresql:// URLs with sslmode work; the API converts them for asyncpg.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag
CORS_ORIGINS=["http://localhost:3000"]

# Uploads: S3-compatible store (SeaweedFS from compose locally, Cloudflare R2 in production)
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=books
# S3_ACCESS_KEY=local
# S3_SECRET_KEY=local
# MAX_UPLOAD_BYTES=52428800
# MAX_UPLOAD_PAGES=1000
# LLM_PROVIDER=ollama            # chat model: "ollama", or "fake" (no model)
# LLM_MODEL=qwen2.5:7b-instruct
# EMBEDDING_PROVIDER=ollama      # must match the worker's embedding model
# EMBEDDING_MODEL=bge-m3
# OLLAMA_URL=http://localhost:11434
# VECTOR_STORE=pgvector         # experiment (ADR 0008, expires 2026-12-15): or "qdrant"
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=chunks

# Ingestion worker (python -m book_rag_worker run)
# S3_ENDPOINT_URL=...           # read uploads from S3; unset = read STORAGE_DIR
# STORAGE_DIR=storage            # where uploaded PDFs live (without S3)
# EMBEDDING_PROVIDER=ollama      # "ollama", or "fake" (no model)
# EMBEDDING_MODEL=bge-m3
# OLLAMA_URL=http://localhost:11434
# VECTOR_STORE=pgvector         # must match the API; "qdrant" also copies vectors to Qdrant
# QDRANT_URL=http://localhost:6333

# Web (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
