# Copy to .env (git-ignored) and adjust. The API reads these; defaults suit `docker compose up`.
# To use Neon instead, run `neon env pull`: it writes DATABASE_URL to .env.local, which overrides .env.
# Plain postgresql:// URLs with sslmode work; the API converts them for asyncpg.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag
CORS_ORIGINS=["http://localhost:3000"]

# Ingestion worker (python -m book_rag_worker run)
# STORAGE_DIR=storage            # where uploaded PDFs live
# EMBEDDING_PROVIDER=ollama      # "ollama", or "fake" (no model)
# EMBEDDING_MODEL=bge-m3
# OLLAMA_URL=http://localhost:11434

# Web (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
