# Copy to .env (git-ignored) and adjust. The API reads these; defaults suit `docker compose up`.
# To use Neon instead, run `neon env pull`: it writes DATABASE_URL to .env.local, which overrides .env.
# Plain postgresql:// URLs with sslmode work; the API converts them for asyncpg.
# ENVIRONMENT decides who a request is (#230). In "development" and "test" the API trusts the
# X-Dev-User request header as the caller's id (the web app sends NEXT_PUBLIC_DEV_USER, default
# "dev-user", the owner of every book that existed before owners did). In any other value the
# header is ignored and every data route answers 401 until a real login is wired in (ADR 0006).
ENVIRONMENT=development
# MCP_OWNER_ID=dev-user         # whose books the MCP server (stdio, no login) reads
DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag
CORS_ORIGINS=["http://localhost:3000"]
# LOG_FORMAT=text               # API and worker logs: "text" (default) or "json" (one object per line)

# Uploads: S3-compatible store (SeaweedFS from compose locally, Cloudflare R2 in production)
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=books
# S3_ACCESS_KEY=local
# S3_SECRET_KEY=local
# MAX_UPLOAD_BYTES=52428800
# MAX_UPLOAD_PAGES=1000
# LLM_PROVIDER=ollama            # chat model: "ollama", "openai" (llama.cpp server, vLLM) or "fake"
# LLM_BASE_URL=http://127.0.0.1:8080   # used when LLM_PROVIDER=openai
# LLM_API_KEY=                   # optional bearer token for that server
# LLM_MODEL=qwen2.5:0.5b-instruct
# EMBEDDING_PROVIDER=ollama      # must match the worker's embedding model
# EMBEDDING_MODEL=bge-m3
# OLLAMA_URL=http://127.0.0.1:11434
# CHAT_HISTORY_MAX_TURNS=6       # earlier turns a chat request may carry (client-held history); more is a 422; 0 refuses history
# CHAT_HISTORY_MAX_CHARS=1500    # characters per history turn; longer is a 422
# SHUTDOWN_DRAIN_TIMEOUT=20      # seconds to let streaming answers finish at shutdown (docs/operations/shutdown.md)
# RERANKER_PROVIDER=none         # "tei" (compose.reranker.yaml, ADR 0009), or "fake" (no model)
# RERANKER_URL=http://127.0.0.1:8080
# RERANK_DEPTH=20                # fused candidates the reranker scores (1-60)
# RERANK_TIMEOUT=10              # seconds; on timeout or error the fused order is used
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318   # tracing is off unless set (docs/operations/tracing.md)

# Ingestion worker (python -m book_rag_worker run)
# S3_ENDPOINT_URL=...           # read uploads from S3; unset = read STORAGE_DIR
# STORAGE_DIR=storage            # where uploaded PDFs live (without S3)
# EMBEDDING_PROVIDER=ollama      # "ollama", or "fake" (no model)
# EMBEDDING_MODEL=bge-m3
# OLLAMA_URL=http://127.0.0.1:11434
# SHUTDOWN_TIMEOUT=20            # seconds the running job may finish after SIGTERM, then it goes back to the queue
# PAGE_READER=none               # "tesseract" reads image-only pages (needs the tesseract binary, vie+eng packs)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318   # tracing is off unless set

# Web (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DEV_USER=dev-user  # sent as X-Dev-User; only honoured when the API runs in development or test
