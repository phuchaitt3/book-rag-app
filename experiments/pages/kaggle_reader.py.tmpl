"""Kaggle kernel for #273 (generated by scripts/kaggle_run.py from this template; do not edit the copy).

One T4. Qwen2.5-VL-3B-Instruct in float16 through `transformers`, temperature 0 (greedy). Reads the
pages of the bundled manifest: downloads each image from its `image_url`, checks `image_sha256`,
and writes the raw text and the seconds per page for every configuration in `reader_config.json`.
Scoring happens on the laptop (`experiments/pages/vlm_score.py`).
Commit of the repository when built: __COMMIT__
"""
import base64, hashlib, io, json, pathlib, subprocess, sys, time, traceback, urllib.request, zipfile

BUNDLE = "__BUNDLE__"
MODEL = "Qwen/Qwen2.5-VL-3B-Instruct"
REVISION = "66285546d2b821cf421d4f5eb2576359d3770cd3"
MAX_NEW_TOKENS = 3000
W = pathlib.Path("/kaggle/working")
B, R, IMG = W / "bundle", W / "results", W / "images"
for d in (R, IMG):
    d.mkdir(parents=True, exist_ok=True)
zipfile.ZipFile(io.BytesIO(base64.b64decode(BUNDLE))).extractall(B)


def fetch(url, want):
    """Download one page image; fail unless its SHA-256 is the manifest's."""
    for attempt in range(5):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "page-reader-benchmark/1.0"})
            data = urllib.request.urlopen(req, timeout=60).read()
        except Exception:
            if attempt == 4:
                raise
            time.sleep(15 * (attempt + 1))
            continue
        got = hashlib.sha256(data).hexdigest()
        if got != want:
            raise ValueError(f"sha256 {got} does not match {want}")
        return data


rows = [json.loads(line) for line in (B / "manifest.jsonl").read_text(encoding="utf-8").splitlines()]
configs = json.loads((B / "reader_config.json").read_text(encoding="utf-8"))["configs"]
# Download and check every image before loading the model, so a bad image fails in seconds.
for m in rows:
    (IMG / f"{m['id']}.jpg").write_bytes(fetch(m["image_url"], m["image_sha256"]))
    time.sleep(1)
print("images ok:", len(rows), flush=True)

subprocess.run("pip install -q 'transformers==4.51.3' 'accelerate>=1.2'", shell=True, check=True)
import torch
import transformers
from PIL import Image
from transformers import AutoProcessor, Qwen2_5_VLForConditionalGeneration

model = Qwen2_5_VLForConditionalGeneration.from_pretrained(
    MODEL, revision=REVISION, torch_dtype=torch.float16, attn_implementation="sdpa"
).to("cuda:0").eval()
gpu = subprocess.run("nvidia-smi --query-gpu=name,driver_version --format=csv,noheader",
                     shell=True, capture_output=True, text=True).stdout.strip()
(R / "env.txt").write_text(
    f"GPU: {gpu}\npython {sys.version.split()[0]}; torch {torch.__version__}; "
    f"transformers {transformers.__version__}\nmodel {MODEL}@{REVISION}; float16; sdpa; "
    f"greedy; max_new_tokens {MAX_NEW_TOKENS}\nrepo commit __COMMIT__\n")

for c in configs:
    processor = AutoProcessor.from_pretrained(
        MODEL, revision=REVISION, min_pixels=256 * 28 * 28, max_pixels=c["max_pixels"])
    torch.cuda.reset_peak_memory_stats()
    out = (R / f"vlm-{c['name']}.jsonl").open("w", encoding="utf-8")
    for m in rows:
        try:
            image = Image.open(IMG / f"{m['id']}.jpg").convert("RGB")
            messages = [{"role": "user", "content": [{"type": "image"},
                                                     {"type": "text", "text": c["prompt"]}]}]
            text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
            t0 = time.time()
            inputs = processor(text=[text], images=[image], return_tensors="pt").to("cuda:0")
            with torch.inference_mode():
                ids = model.generate(**inputs, max_new_tokens=MAX_NEW_TOKENS, do_sample=False)
            new = ids[0][inputs["input_ids"].shape[1]:]
            row = {"id": m["id"], "set": m["set"], "config": c["name"],
                   "text": processor.decode(new, skip_special_tokens=True),
                   "seconds": round(time.time() - t0, 2), "new_tokens": int(len(new)),
                   "hit_limit": bool(len(new) >= MAX_NEW_TOKENS),
                   "input_tokens": int(inputs["input_ids"].shape[1]),
                   "peak_vram_mib": torch.cuda.max_memory_allocated() // (1 << 20)}
        except Exception:
            row = {"id": m["id"], "set": m["set"], "config": c["name"],
                   "error": traceback.format_exc()}
        out.write(json.dumps(row, ensure_ascii=False) + "\n")
        out.flush()
        print(c["name"], m["id"], row.get("seconds"), row.get("new_tokens"),
              "ERROR" if "error" in row else "", flush=True)
    out.close()
for p in IMG.iterdir():
    p.unlink()
print("done", sorted(p.name for p in R.iterdir()), flush=True)
