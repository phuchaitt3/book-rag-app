"""Kaggle kernel for #245 (generated by scripts/kaggle_run.py from this template; do not edit the copy).

One T4 (CUDA_VISIBLE_DEVICES=0). Arm A: vLLM serving Qwen2.5-3B-Instruct AWQ. Arm B: Ollama serving
qwen2.5:3b-instruct (Q4_K_M). Both run the same concurrency_bench.py over the same prompts.
Each arm is wrapped so a failure in one is recorded and the other still runs.
Commit of the repository when built: __COMMIT__
"""
import base64, io, json, os, pathlib, shutil, signal, subprocess, sys, time, traceback, urllib.request, zipfile

BUNDLE = "__BUNDLE__"
VLLM_VERSION = "0.10.2"
VLLM_MODEL = "Qwen/Qwen2.5-3B-Instruct-AWQ"
OLLAMA_MODEL = "qwen2.5:3b-instruct"
W = pathlib.Path("/kaggle/working")
B, R = W / "bundle", W / "results"
R.mkdir(parents=True, exist_ok=True)
zipfile.ZipFile(io.BytesIO(base64.b64decode(BUNDLE))).extractall(B)
ENV = {**os.environ, "CUDA_VISIBLE_DEVICES": "0"}


def sh(cmd, **kw):
    print("$", cmd, flush=True)
    return subprocess.run(cmd, shell=True, env=kw.pop("env", ENV), **kw)


def wait_http(url, seconds):
    end = time.time() + seconds
    while time.time() < end:
        try:
            urllib.request.urlopen(url, timeout=5).read()
            return True
        except Exception:
            time.sleep(5)
    return False


def bench(label, base_url, model, info):
    env = {**ENV, "BASE_URL": base_url, "MODEL": model, "LABEL": label, "PROMPTS": str(B / "prompts.jsonl"),
           "OUT_DIR": str(R), "SERVER_INFO": info, "CONCURRENCY": "1,4,16"}
    r = sh(f"{sys.executable} {B / 'concurrency_bench.py'}", env=env)
    print(label, "bench exit", r.returncode, flush=True)


def stop(proc):
    proc.send_signal(signal.SIGTERM)
    try:
        proc.wait(60)
    except Exception:
        proc.kill()
    time.sleep(10)


def arm(name, fn):
    try:
        fn()
    except Exception:
        (R / f"{name}-error.txt").write_text(traceback.format_exc())
        traceback.print_exc()


def vllm_arm():
    sh("pip install -q uv")
    sh("uv venv /tmp/v && uv pip install -q --python /tmp/v/bin/python vllm==%s" % VLLM_VERSION, check=True)
    ver = subprocess.run("/tmp/v/bin/python -c 'import vllm,torch;print(vllm.__version__,torch.__version__)'",
                         shell=True, capture_output=True, text=True).stdout.strip()
    log = open(R / "vllm-server.log", "w")
    # Turing (T4, sm75): no bf16, no FlashAttention 2; use half and the xformers backend.
    env = {**ENV, "VLLM_ATTENTION_BACKEND": "XFORMERS"}
    proc = subprocess.Popen(
        f"/tmp/v/bin/vllm serve {VLLM_MODEL} --dtype half --quantization awq --max-model-len 8192 "
        f"--gpu-memory-utilization 0.85 --max-num-seqs 16 --port 8000 --served-model-name qwen",
        shell=True, env=env, stdout=log, stderr=subprocess.STDOUT, preexec_fn=os.setsid)
    try:
        if not wait_http("http://127.0.0.1:8000/v1/models", 1200):
            raise RuntimeError("vllm server did not come up in 20 minutes")
        bench("vllm-awq", "http://127.0.0.1:8000", "qwen",
              f"vLLM {ver}; {VLLM_MODEL}; --dtype half --quantization awq --max-model-len 8192 "
              "--gpu-memory-utilization 0.85 --max-num-seqs 16; XFORMERS attention; T4 15 GB")
    finally:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        time.sleep(15)


def ollama_arm():
    # Official install script (a Kaggle sandbox, not the user's machine); the version is recorded.
    sh("curl -fsSL https://ollama.com/install.sh | sh", check=True)
    ver = subprocess.run("ollama --version", shell=True, capture_output=True, text=True).stdout.strip()
    env = {**ENV, "OLLAMA_HOST": "127.0.0.1:11434", "OLLAMA_NUM_PARALLEL": "16", "OLLAMA_CONTEXT_LENGTH": "8192",
           "OLLAMA_KEEP_ALIVE": "60m"}
    log = open(R / "ollama-server.log", "w")
    proc = subprocess.Popen("ollama serve", shell=True, env=env, stdout=log, stderr=subprocess.STDOUT,
                            preexec_fn=os.setsid)
    try:
        if not wait_http("http://127.0.0.1:11434/api/tags", 120):
            raise RuntimeError("ollama server did not come up")
        sh(f"ollama pull {OLLAMA_MODEL}", env=env, check=True)
        show = subprocess.run(f"ollama show {OLLAMA_MODEL}", shell=True, capture_output=True, text=True, env=env).stdout
        (R / "ollama-show.txt").write_text(show)
        bench("ollama-q4km", "http://127.0.0.1:11434", OLLAMA_MODEL,
              f"{ver}; {OLLAMA_MODEL} (Q4_K_M GGUF from the Ollama registry); OLLAMA_NUM_PARALLEL=16 "
              "OLLAMA_CONTEXT_LENGTH=8192; T4 15 GB")
    finally:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)


(R / "env.txt").write_text(
    subprocess.run("nvidia-smi; python --version; df -h /kaggle/working | tail -1", shell=True,
                   capture_output=True, text=True).stdout + "\nrepo commit __COMMIT__\n")
arm("vllm", vllm_arm)
arm("ollama", ollama_arm)
shutil.rmtree(B, ignore_errors=True)
print("done", sorted(p.name for p in R.iterdir()), flush=True)
